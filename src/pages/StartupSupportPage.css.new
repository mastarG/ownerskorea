/* Inquiry Form Premium Light Theme */
.inquiry-section-refined-v5 {
  background: white !important;
  border-radius: 24px !important;
  padding: 3.5rem !important;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1) !important;
  border: 1px solid #e5e7eb !important;
  color: #0b192c !important;
  margin-top: 3rem !important;
}

.compact-form-v5-new .expert-label-badge-v5 {
  color: #0b192c !important;
  border-bottom: none !important;
  padding-bottom: 0 !important;
  margin-bottom: 0.5rem !important;
  font-size: 1.5rem !important;
}

.compact-form-v5-new p.text-white {
  color: #4b5563 !important;
  opacity: 1 !important;
  font-size: 0.95rem !important;
}

.inquiry-label-v5 {
  color: #0b192c !important;
  font-weight: 700 !important;
  display: block;
  margin-bottom: 0.5rem;
}

.inquiry-input-v5 {
  background: #f9fafb !important;
  border: 1px solid #d1d5db !important;
  color: #0b192c !important;
  border-radius: 12px !important;
  padding: 1rem !important;
  width: 100%;
}

.inquiry-input-v5::placeholder {
  color: #9ca3af !important;
}

.inquiry-input-v5:focus {
  background: white !important;
  border-color: #d4af37 !important;
  box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1) !important;
  outline: none;
}

/* Snap Footer Section */
.snap-footer-section {
  scroll-snap-align: start;
  width: 100%;
  background: #0b192c;
}

.snap-footer-section footer {
  padding-top: 4rem;
  padding-bottom: 4rem;
}
